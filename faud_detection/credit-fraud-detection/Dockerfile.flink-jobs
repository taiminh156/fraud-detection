# Build stage (multi-arch friendly; compile target remains Java 8 from pom.xml)
FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests clean package

# Runtime stage (align with Flink dependencies in pom.xml)
FROM flink:1.20.1-scala_2.12-java11

RUN mkdir -p /opt/flink/usrlib
RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop && cp /opt/flink/opt/flink-s3-fs-hadoop-*.jar /opt/flink/plugins/s3-fs-hadoop/

# Copy shaded fat-jar (avoid picking original-*.jar)
COPY --from=builder /build/target/credit-fraud-detection-1.0-SNAPSHOT.jar /opt/flink/usrlib/credit-fraud-jobs.jar
